{
  "about": "DNS providers MeshHome offers for HTTPS certificates (DNS-01 via lego). Field env names are lego's; see each provider's docs link.",
  "providers": [
    {
      "id": "cloudflare",
      "name": "Cloudflare",
      "lego": "cloudflare",
      "fields": [
        {
          "env": "CF_DNS_API_TOKEN",
          "label": "API token",
          "secret": true,
          "required": true
        }
      ],
      "help": "Create an API token at dash.cloudflare.com → My Profile → API Tokens with the “Edit zone DNS” template, limited to the zone that contains your hostname.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/cloudflare/"
    },
    {
      "id": "route53",
      "name": "Amazon Route 53",
      "lego": "route53",
      "fields": [
        {
          "env": "AWS_ACCESS_KEY_ID",
          "label": "Access key ID",
          "secret": false,
          "required": true
        },
        {
          "env": "AWS_SECRET_ACCESS_KEY",
          "label": "Secret access key",
          "secret": true,
          "required": true
        },
        {
          "env": "AWS_REGION",
          "label": "Region",
          "secret": false,
          "required": true,
          "default": "us-east-1"
        },
        {
          "env": "AWS_HOSTED_ZONE_ID",
          "label": "Hosted zone ID (optional)",
          "secret": false,
          "required": false
        }
      ],
      "help": "Create an IAM user with route53:ListHostedZonesByName, route53:GetChange and route53:ChangeResourceRecordSets on your hosted zone, then create an access key for it.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/route53/"
    },
    {
      "id": "gcloud",
      "name": "Google Cloud DNS",
      "lego": "gcloud",
      "fields": [
        {
          "env": "GCE_PROJECT",
          "label": "Project ID",
          "secret": false,
          "required": true
        },
        {
          "env": "GCE_SERVICE_ACCOUNT_FILE",
          "label": "Service account key (JSON)",
          "secret": true,
          "required": true,
          "kind": "json"
        }
      ],
      "help": "Create a service account with the “DNS Administrator” role and download a JSON key for it. Paste the whole JSON file.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/gcloud/"
    },
    {
      "id": "azuredns",
      "name": "Azure DNS",
      "lego": "azuredns",
      "fields": [
        {
          "env": "AZURE_TENANT_ID",
          "label": "Tenant ID",
          "secret": false,
          "required": true
        },
        {
          "env": "AZURE_CLIENT_ID",
          "label": "Client (application) ID",
          "secret": false,
          "required": true
        },
        {
          "env": "AZURE_CLIENT_SECRET",
          "label": "Client secret",
          "secret": true,
          "required": true
        },
        {
          "env": "AZURE_SUBSCRIPTION_ID",
          "label": "Subscription ID",
          "secret": false,
          "required": true
        },
        {
          "env": "AZURE_RESOURCE_GROUP",
          "label": "Resource group of the DNS zone",
          "secret": false,
          "required": true
        }
      ],
      "help": "Register an app in Microsoft Entra ID, create a client secret, and give it the “DNS Zone Contributor” role on your DNS zone.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/azuredns/"
    },
    {
      "id": "digitalocean",
      "name": "DigitalOcean",
      "lego": "digitalocean",
      "fields": [
        {
          "env": "DO_AUTH_TOKEN",
          "label": "API token",
          "secret": true,
          "required": true
        }
      ],
      "help": "Create a personal access token (API → Tokens) with write access to Domains.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/digitalocean/"
    },
    {
      "id": "godaddy",
      "name": "GoDaddy",
      "lego": "godaddy",
      "fields": [
        {
          "env": "GODADDY_API_KEY",
          "label": "API key",
          "secret": false,
          "required": true
        },
        {
          "env": "GODADDY_API_SECRET",
          "label": "API secret",
          "secret": true,
          "required": true
        }
      ],
      "help": "Create a Production API key at developer.godaddy.com/keys.",
      "note": "GoDaddy only allows DNS API access for accounts with 10 or more domains or a paid plan. If yours is refused, delegate validation (see “My provider isn't listed”).",
      "docs": "https://go-acme.github.io/lego/dns/godaddy/"
    },
    {
      "id": "namecheap",
      "name": "Namecheap",
      "lego": "namecheap",
      "fields": [
        {
          "env": "NAMECHEAP_API_USER",
          "label": "API user (your username)",
          "secret": false,
          "required": true
        },
        {
          "env": "NAMECHEAP_API_KEY",
          "label": "API key",
          "secret": true,
          "required": true
        }
      ],
      "help": "Turn on API access under Profile → Tools → API Access, and add this network's public IP address to the allowlist there.",
      "note": "Namecheap requires API access to be enabled for the account and your public IP address to be on its allowlist.",
      "docs": "https://go-acme.github.io/lego/dns/namecheap/"
    },
    {
      "id": "porkbun",
      "name": "Porkbun",
      "lego": "porkbun",
      "fields": [
        {
          "env": "PORKBUN_API_KEY",
          "label": "API key",
          "secret": false,
          "required": true
        },
        {
          "env": "PORKBUN_SECRET_API_KEY",
          "label": "Secret API key",
          "secret": true,
          "required": true
        }
      ],
      "help": "Create an API key at porkbun.com/account/api, then turn on “API Access” for the domain.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/porkbun/"
    },
    {
      "id": "ovh",
      "name": "OVHcloud",
      "lego": "ovh",
      "fields": [
        {
          "env": "OVH_ENDPOINT",
          "label": "Endpoint",
          "secret": false,
          "required": true,
          "kind": "choice",
          "choices": [
            "ovh-eu",
            "ovh-ca",
            "ovh-us"
          ],
          "default": "ovh-eu"
        },
        {
          "env": "OVH_APPLICATION_KEY",
          "label": "Application key",
          "secret": false,
          "required": true
        },
        {
          "env": "OVH_APPLICATION_SECRET",
          "label": "Application secret",
          "secret": true,
          "required": true
        },
        {
          "env": "OVH_CONSUMER_KEY",
          "label": "Consumer key",
          "secret": true,
          "required": true
        }
      ],
      "help": "Create application credentials at the OVH API token page for your region with GET/PUT/POST/DELETE on /domain/zone/*.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/ovh/"
    },
    {
      "id": "gandiv5",
      "name": "Gandi",
      "lego": "gandiv5",
      "fields": [
        {
          "env": "GANDIV5_PERSONAL_ACCESS_TOKEN",
          "label": "Personal access token",
          "secret": true,
          "required": true
        }
      ],
      "help": "Create a personal access token in the Gandi admin (Organization → Sharing → Personal Access Token) with “Manage domain technical configurations”.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/gandiv5/"
    },
    {
      "id": "hetzner",
      "name": "Hetzner DNS",
      "lego": "hetzner",
      "fields": [
        {
          "env": "HETZNER_API_TOKEN",
          "label": "API token",
          "secret": true,
