    {
      "id": "dnsupdate",
      "name": "Self-hosted DNS (RFC 2136: BIND, PowerDNS, Knot, Technitium)",
      "lego": "dnsupdate",
      "fields": [
        {
          "env": "DNSUPDATE_NAMESERVER",
          "label": "Nameserver (host or host:port)",
          "secret": false,
          "required": true
        },
        {
          "env": "DNSUPDATE_TSIG_KEY",
          "label": "TSIG key name",
          "secret": false,
          "required": true
        },
        {
          "env": "DNSUPDATE_TSIG_SECRET",
          "label": "TSIG secret (base64)",
          "secret": true,
          "required": true
        },
        {
          "env": "DNSUPDATE_TSIG_ALGORITHM",
          "label": "TSIG algorithm",
          "secret": false,
          "required": true,
          "kind": "choice",
          "choices": [
            "hmac-sha256.",
            "hmac-sha512.",
            "hmac-sha1."
          ],
          "default": "hmac-sha256."
        }
      ],
      "help": "Allow dynamic updates for the zone (or just for _acme-challenge) with a TSIG key, e.g. one made with tsig-keygen.",
      "note": null,
      "docs": "https://go-acme.github.io/lego/dns/dnsupdate/"
